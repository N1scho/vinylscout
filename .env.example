# .env.example — Kopie als .env (nicht .env.local!) anlegen und Werte eintragen.
# .env wird NIE committet (siehe .gitignore).

# Discogs Personal Access Token (https://www.discogs.com/settings/developers)
DISCOGS_TOKEN=

# Anthropic API Key (https://platform.claude.com/) — für Kamera-Erkennung
ANTHROPIC_API_KEY=
